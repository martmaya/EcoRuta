rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userOwnsPath(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validCategory(userId) {
      return request.resource.data.keys().hasAll(['uid', 'nombre', 'descripcion', 'icono', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'descripcion', 'icono', 'createdAt'])
          && request.resource.data.uid == userId
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 40
          && request.resource.data.descripcion is string
          && request.resource.data.descripcion.size() <= 160
          && request.resource.data.icono in ['leaf', 'water', 'recycle', 'bike', 'sun', 'tree', 'ordenar', 'reciclar', 'ahorro'];
    }

    function validAction(userId) {
      return request.resource.data.keys().hasAll(['uid', 'categoriaId', 'categoriaNombre', 'nombre', 'descripcion', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'categoriaId', 'categoriaNombre', 'nombre', 'descripcion', 'createdAt'])
          && request.resource.data.uid == userId
          && request.resource.data.categoriaId is string
          && request.resource.data.categoriaId.size() > 0
          && request.resource.data.categoriaId.size() <= 100
          && exists(/databases/$(database)/documents/users/$(userId)/categorias/$(request.resource.data.categoriaId))
          && request.resource.data.categoriaNombre is string
          && request.resource.data.categoriaNombre.size() > 0
          && request.resource.data.categoriaNombre.size() <= 40
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.descripcion is string
          && request.resource.data.descripcion.size() <= 500;
    }

    match /users/{userId}/categorias/{categoryId} {
      allow get, list: if userOwnsPath(userId);
      allow create: if userOwnsPath(userId) && validCategory(userId)
          && request.resource.data.createdAt == request.time;
      allow update: if userOwnsPath(userId) && resource.data.uid == userId
          && validCategory(userId)
          && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if userOwnsPath(userId) && resource.data.uid == userId;
    }

    match /users/{userId}/acciones/{actionId} {
      allow get, list: if userOwnsPath(userId);
      allow create: if userOwnsPath(userId) && validAction(userId)
          && request.resource.data.createdAt == request.time;
      allow delete: if userOwnsPath(userId) && resource.data.uid == userId;
      allow update: if userOwnsPath(userId) && resource.data.uid == userId
          && validAction(userId)
          && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
