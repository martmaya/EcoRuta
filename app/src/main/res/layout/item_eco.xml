<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#F2F8F1"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/txtAccion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#245B38" android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/btnEliminarAccion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="40dp" android:text="@string/eliminar" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/txtCategoria" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="14sp" />
    <TextView android:id="@+id/txtFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" />
    <TextView android:id="@+id/txtImpacto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="14sp" />
    <TextView android:id="@+id/txtDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" />
</LinearLayout>
