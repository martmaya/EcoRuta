<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screenLogin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white">
        <View
            android:layout_width="440dp"
            android:layout_height="340dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_auth_orb"
            android:translationX="-120dp"
            android:translationY="-170dp" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="188dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_titulo" android:textColor="@color/eco_navy" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnIrCrearCuenta" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:clickable="true" android:focusable="true" android:gravity="start|center_vertical" android:text="@string/ir_crear_cuenta" android:textColor="@color/eco_auth_blue" android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="0dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                        <EditText android:id="@+id/inputCorreo" android:layout_width="match_parent" android:layout_height="54dp" android:autofillHints="emailAddress" android:background="@drawable/bg_auth_input" android:hint="@string/hint_correo" android:inputType="textEmailAddress" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/bg_auth_input" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="8dp">
                            <EditText android:id="@+id/inputContrasena" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:autofillHints="password" android:background="@android:color/transparent" android:hint="@string/hint_contrasena" android:inputType="textPassword" android:padding="0dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
                            <TextView android:id="@+id/btnMostrarClave" android:layout_width="wrap_content" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="8dp" android:text="@string/mostrar" android:textColor="@color/eco_auth_blue" android:textStyle="bold" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnIniciarSesion" android:layout_width="150dp" android:layout_height="50dp" android:layout_gravity="end" android:layout_marginTop="24dp" android:text="@string/iniciar_sesion" android:textColor="@color/white" app:backgroundTint="@color/eco_auth_blue" app:cornerRadius="25dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/login_ayuda" android:textColor="@color/eco_muted" android:textSize="12sp" android:visibility="gone" />
                        <TextView android:id="@+id/txtConfiguracion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/firebase_no_configurado" android:textColor="#B43E4B" android:textSize="12sp" android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/screenSignup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:visibility="gone">
        <View
            android:layout_width="440dp"
            android:layout_height="340dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_auth_orb"
            android:translationX="-120dp"
            android:translationY="-170dp" />
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="16dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/btnVolverALogin" android:layout_width="wrap_content" android:layout_height="40dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:text="@string/volver" android:textColor="@color/eco_auth_blue" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="136dp" android:text="@string/registro_cuenta_titulo" android:textColor="@color/eco_navy" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/registro_cuenta_subtitulo" android:textColor="@color/eco_muted" android:textSize="14sp" android:visibility="gone" />
                <TextView android:id="@+id/btnVolverALoginTexto" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:clickable="true" android:focusable="true" android:gravity="start|center_vertical" android:text="@string/volver_iniciar_sesion" android:textColor="@color/eco_auth_blue" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="0dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                        <EditText android:id="@+id/inputCorreoRegistro" android:layout_width="match_parent" android:layout_height="54dp" android:autofillHints="emailAddress" android:background="@drawable/bg_auth_input" android:hint="@string/hint_correo" android:inputType="textEmailAddress" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
                        <EditText android:id="@+id/inputContrasenaRegistro" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:autofillHints="newPassword" android:background="@drawable/bg_auth_input" android:hint="@string/hint_contrasena" android:inputType="textPassword" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
                        <EditText android:id="@+id/inputConfirmarContrasenaRegistro" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:autofillHints="newPassword" android:background="@drawable/bg_auth_input" android:hint="@string/confirmar_contrasena" android:inputType="textPassword" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCrearCuenta" android:layout_width="160dp" android:layout_height="50dp" android:layout_gravity="end" android:layout_marginTop="24dp" android:text="@string/crear_cuenta" android:textColor="@color/white" app:backgroundTint="@color/eco_auth_blue" app:cornerRadius="25dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/screenHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/eco_canvas"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_category_recycle"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/eco_green_dark"
                    android:gravity="center_vertical"
                    android:text="@string/app_name"
                    android:textColor="@color/eco_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/bienvenida"
                    android:textColor="@color/eco_navy"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/frase_motivadora"
                    android:textColor="@color/eco_muted"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="152dp"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/eco_blue_panel"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_impact_card"
                        android:clipChildren="false">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="132dp"
                            android:paddingBottom="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/progreso_titulo"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/txtTotalAcciones"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/numero_cero"
                                    android:textColor="@color/white"
                                    android:textSize="40sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/acciones_registradas"
                                    android:textColor="#EAF7FD"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/imgEarthHero"
                            android:layout_width="154dp"
                            android:layout_height="154dp"
                            android:layout_gravity="end|center_vertical"
                            android:contentDescription="@string/desc_tierra"
                            android:scaleType="matrix"
                            android:src="@drawable/earth_leaf"
                            android:translationX="10dp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/categorias_titulo"
                    android:textColor="@color/eco_navy"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/categorias_subtitulo"
                    android:textColor="@color/eco_muted"
                    android:textSize="13sp" />
                <LinearLayout
                    android:id="@+id/contenedorCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screenRegister"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/eco_canvas"
        android:orientation="vertical"
        android:visibility="gone">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginStart="16dp" android:layout_marginTop="50dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="@color/eco_blue_panel" app:cardCornerRadius="22dp" app:cardElevation="2dp" app:strokeWidth="0dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="64dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/titulo_registro" android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/registro_pantalla_subtitulo" android:textColor="#F1F4E9" android:textSize="13sp" />
                </LinearLayout>
                <ImageView android:layout_width="46dp" android:layout_height="46dp" android:layout_gravity="top|end" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" android:alpha="0.95" android:contentDescription="@null" android:rotation="24" android:src="@drawable/ic_decor_leaf" app:tint="@color/eco_green" />
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:layout_marginEnd="46dp" android:layout_marginBottom="10dp" android:alpha="0.95" android:contentDescription="@null" android:rotation="-26" android:src="@drawable/ic_decor_leaf" app:tint="@color/eco_green" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp" android:paddingEnd="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/elige_registro" android:textColor="@color/eco_navy" android:textSize="17sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardNuevaCategoria" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/white" app:cardCornerRadius="20dp" app:cardElevation="2dp" app:strokeColor="@color/eco_canvas" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                    <TextView android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_green_circle" android:gravity="center" android:text="@string/icono_agregar" android:textColor="@color/eco_green_dark" android:textSize="30sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nueva_categoria" android:textColor="@color/eco_navy" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/desc_nueva_categoria" android:textColor="@color/eco_muted" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardNuevaAccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/white" app:cardCornerRadius="20dp" app:cardElevation="2dp" app:strokeColor="@color/eco_canvas" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                    <ImageView android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_green_circle" android:contentDescription="@string/nueva_accion" android:padding="11dp" android:src="@drawable/ic_category_recycle" app:tint="@color/eco_green_dark" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nueva_accion" android:textColor="@color/eco_navy" android:textSize="17sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/desc_nueva_accion" android:textColor="@color/eco_muted" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/screenProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginStart="16dp" android:layout_marginTop="50dp" android:layout_marginEnd="16dp" app:cardBackgroundColor="@color/eco_blue_panel" app:cardCornerRadius="22dp" app:cardElevation="2dp" app:strokeWidth="0dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="64dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/perfil_titulo" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/perfil_subtitulo" android:textColor="#F1F4E9" android:textSize="14sp" />
                </LinearLayout>
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_marginTop="10dp" android:layout_marginEnd="15dp" android:alpha="0.95" android:contentDescription="@null" android:rotation="20" android:src="@drawable/ic_decor_leaf" app:tint="@color/eco_green" />
                <ImageView android:layout_width="31dp" android:layout_height="31dp" android:layout_gravity="bottom|end" android:layout_marginEnd="48dp" android:layout_marginBottom="9dp" android:alpha="0.95" android:contentDescription="@null" android:rotation="-22" android:src="@drawable/ic_decor_leaf" app:tint="@color/eco_green" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/eco_canvas" android:gravity="top|center_horizontal" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="28dp" android:paddingEnd="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_white_card" android:elevation="3dp" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
                    <ImageView android:id="@+id/imgFotoPerfil" android:layout_width="82dp" android:layout_height="82dp" android:background="@drawable/bg_green_circle" android:contentDescription="@string/foto_perfil" android:padding="18dp" android:scaleType="centerCrop" android:src="@drawable/ic_nav_profile" />
                    <TextView android:id="@+id/txtNombrePerfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/eco_navy" android:textSize="20sp" android:textStyle="bold" android:visibility="gone" />
                    <TextView android:id="@+id/txtCorreoPerfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/eco_muted" android:textSize="15sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp" android:text="@string/cerrar_sesion" android:textColor="@color/white" app:backgroundTint="@color/eco_green_dark" app:cornerRadius="15dp" />
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navBottom"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_nav"
        android:baselineAligned="false"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">
        <LinearLayout android:id="@+id/btnNavInicio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_nav_home" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_inicio" android:textColor="@color/eco_navy" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnNavRegistrar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_nav_add" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_registrar" android:textColor="@color/eco_navy" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnNavPerfil" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_nav_profile" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/nav_perfil" android:textColor="@color/eco_navy" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
