<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="8dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/selecciona_categoria" android:textColor="@color/eco_navy" android:textSize="14sp" android:textStyle="bold" />
    <Spinner android:id="@+id/selectorCategoriaAccion" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:contentDescription="@string/selecciona_categoria" />
    <EditText android:id="@+id/inputNombreAccion" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:autofillHints="name" android:background="@drawable/bg_input_field" android:hint="@string/hint_accion_nombre" android:inputType="textCapSentences" android:maxLength="80" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
    <EditText android:id="@+id/inputDescripcionAccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_input_field" android:gravity="top" android:hint="@string/hint_accion_descripcion" android:importantForAutofill="no" android:inputType="textCapSentences|textMultiLine" android:maxLength="500" android:minLines="3" android:padding="14dp" android:textColor="@color/eco_navy" android:textColorHint="@color/eco_muted" />
    <TextView android:id="@+id/txtFechaRegistro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/eco_muted" android:textSize="12sp" />
</LinearLayout>
